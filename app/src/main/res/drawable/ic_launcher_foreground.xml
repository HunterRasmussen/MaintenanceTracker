                android:pathData="M7,-2.2 H7.6 A1,1 0 0,1 8.6,-1.2 V1.2 A1,1 0 0,1 7.6,2.2 H7 A1,1 0 0,1 6,1.2 V-1.2 A1,1 0 0,1 7,-2.2 Z" />
